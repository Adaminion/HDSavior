<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    HDSavior reads raw disks (\\.\PhysicalDriveN), which Windows allows only to
    elevated processes. The app therefore asks for administrator rights once,
    at start (one UAC prompt); the engine child process inherits the elevated
    token (docs/ARCHITECTURE.md, section 4).

    This element is the only place where the execution level is declared: the
    linker's own default fragment ("asInvoker") is switched off in
    CMakeLists.txt with /MANIFESTUAC:NO, because two different levels cannot
    be merged (mt.exe error c1010001).
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
